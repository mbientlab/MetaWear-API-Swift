<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest for the MetaWear app.

	  NSPrivacyTracking: the app does not track users (no cross-app/website
	  linking of data for advertising or sharing with data brokers).

	  NSPrivacyCollectedDataTypes: empty. Sensor data and sessions are stored
	  only in the app's local SwiftData store. Remembered-device metadata is
	  stored in a separate CloudKit-backed SwiftData store so it can sync through
	  the user's private iCloud account, which is keyed to their Apple ID and is
	  not accessible to MbientLab. CSV exports are user-initiated (share sheet /
	  Files) and stay under the user's control. No data is transmitted to
	  MbientLab servers or any third party.

	  NSPrivacyAccessedAPITypes: UserDefaults (CA92.1 — access data written
	  only by the app itself). Used for the host-local map of board MAC
	  addresses to this device's CoreBluetooth peripheral UUIDs, which links
	  iCloud-synced remembered boards to locally discovered peripherals. A code
	  audit found no other required-reason API usage (no file-timestamp,
	  disk-space, active-keyboard, or system-boot-time access). The bundled
	  third-party SDKs (NordicDFU and ZIPFoundation, linked via
	  MetaWearFirmware) ship their own privacy manifests, which Xcode
	  aggregates into the archive's privacy report.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
